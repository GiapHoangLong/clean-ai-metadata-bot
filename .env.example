# CleanAI Metadata Stripper Bot Configuration

# Telegram Bot Token (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Daily free quota per user (Default: 50)
DAILY_FREE_LIMIT=50

# Timezone offset in hours (7 for Vietnam UTC+7)
TIMEZONE_OFFSET_HOURS=7

# Max image size allowed for processing (in Megabytes)
MAX_FILE_SIZE_MB=20

# Storage paths
DB_PATH=data/bot.db
TEMP_DIR=scratch/temp_uploads
